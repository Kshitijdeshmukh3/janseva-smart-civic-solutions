# ==============================================================================
# JANSEVA – PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Metadata
PROJECT_NAME="JANSEVA – SMART CIVIC SOLUTIONS"
TAGLINE="Your Area. Your Voice. Our Responsibility."
ENVIRONMENT="production" # development | staging | production
DEBUG=false

# Backend API & Server
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="generate-a-strong-random-64-character-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (MySQL 8.0+ in Production, SQLite fallback in local dev)
DATABASE_URL="mysql+pymysql://janseva_admin:SecurePass123!@aws-rds-mysql-host.rds.amazonaws.com:3306/janseva_db"

# CORS Allowed Origins (Comma separated or JSON array)
BACKEND_CORS_ORIGINS='["https://janseva.vercel.app", "https://janseva.in", "http://localhost:3000"]'

# Media Storage (Cloudinary or AWS S3)
STORAGE_PROVIDER="cloudinary" # cloudinary | s3
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# AI Inference (Optional OpenAI API Key for Multilingual Complaint Assistant)
OPENAI_API_KEY="sk-proj-your-api-key-here"

# Municipal SMS & WhatsApp Gateway (Optional)
SMS_GATEWAY_API_KEY="your-sms-gateway-key"
WHATSAPP_BUSINESS_API_TOKEN="your-whatsapp-meta-token"
